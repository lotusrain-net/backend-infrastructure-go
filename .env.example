# Local Compose development profile. Use HTTPS and COOKIE_SECURE=true in production.
APP_ENV=development
SERVICE_NAME=backend-infrastructure-go
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=30s
HTTP_PORT=8080
WEB_PORT=3000
IMAGE_TAG=local
# Docker Hub proxy for Compose runtime images and Dockerfile build stages.
IMAGE_REGISTRY=public.ecr.aws/docker
# Go module mirror and checksum database used while building the backend image.
GOPROXY=https://goproxy.cn,direct
GOSUMDB=sum.golang.google.cn
# Used while building the Next.js rewrite and at runtime by /api/healthz.
API_PROXY_TARGET=http://api:8080

POSTGRES_DB=backend
POSTGRES_USER=backend
POSTGRES_PASSWORD=replace-with-random-database-password
ALLOW_INSECURE_INTERNAL_TRANSPORT=true
REDIS_TLS=false
JWT_SECRET=replace-with-at-least-32-random-bytes
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-admin-password
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
TRUSTED_PROXY_CIDRS=

# Generate each independently: openssl rand -hex 32. Keep stable across restarts.
AUTHENTICATION_KEY=
AUTHENTICATION_PEPPER=
RECOVERY_CODE_TTL=720h
# Explicit local opt-out; production requires authenticated TLS SMTP.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT=10s
