{
  "name": "backend-infrastructure-web",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "packages/backend-infrastructure-web"
  ],
  "overrides": {
    "esbuild": "0.28.1"
  },
  "type": "module",
  "engines": {
    "node": ">=20.9.0 <21"
  },
  "scripts": {
    "dev": "next dev",
    "build:package": "npm run build --workspace @lotusrain-net/backend-infrastructure-web",
    "build": "npm run build:package && next build",
    "start": "next start",
    "prelint": "npm run build:package",
    "lint": "eslint .",
    "typecheck:package": "npm run typecheck --workspace @lotusrain-net/backend-infrastructure-web",
    "pretypecheck": "npm run build:package",
    "typecheck": "npm run typecheck:package && tsc --noEmit",
    "pretest": "npm run build:package",
    "test": "vitest run",
    "pack:package": "npm pack --workspace @lotusrain-net/backend-infrastructure-web --dry-run",
    "check:package": "npm run typecheck:package && npm run test --workspace @lotusrain-net/backend-infrastructure-web && npm run build:package && npm run publint --workspace @lotusrain-net/backend-infrastructure-web && npm run pack:package",
    "test:package-consumers": "node scripts/test-package-consumers.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lotusrain-net/backend-infrastructure-web": "0.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.90.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.542.0",
    "next": "^16.3.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.83.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.4.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.26",
    "publint": "^0.3.12",
    "tailwindcss": "^4.1.13",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
